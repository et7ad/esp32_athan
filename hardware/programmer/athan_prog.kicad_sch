		(uuid "64895f42-0c72-406d-9b38-b740d5f9fddd")
	)
	(text "Pin 3 (EN) is left open. J1 points down into J6; J2, right beside it, points up for the jumper wires."
		(exclude_from_sim no)
		(at 88.9 73.66 0)
		(effects
			(font
